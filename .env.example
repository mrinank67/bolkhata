# Copy to .env and fill in. Never commit the real .env.
# tests/test_env_parity.py asserts every os.getenv() key in the source appears
# here, so add a line whenever you introduce a new environment variable.

# --- Groq (LLM intent extraction) ---
GROQ_API_KEY=

# --- Sarvam AI (speech-to-text) ---
SARVAM_API_KEY=

# --- Firebase web SDK config (served to the browser via GET /config) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK ---
# The full service-account JSON as a single-line string. Required on Vercel.
# Locally, auth.py falls back to the service-account .json file in the repo root
# when this is unset.
FIREBASE_SERVICE_ACCOUNT=

# --- App ---
# Signing secret for /pay payment links.
PAY_LINK_SECRET=
# Signing secret for bill PDF download tokens. Bills are deleted 30 days after
# last use and rebuilt on demand; deriving the token from this secret is what
# makes a rebuilt bill come back at the same URL, so a link already shared with a
# customer keeps working. Leave unset and tokens are random instead — bills still
# generate, but every rebuild produces a new URL. Changing it has the same effect
# as unsetting it for bills generated before the change.
BILL_TOKEN_SECRET=
# Extra CORS origins, comma-separated. Localhost is always allowed. The deployed
# frontend is same-origin, so this is usually left empty.
ALLOWED_ORIGINS=
# Set to any truthy value to enable verbose server logging.
DEBUG_LOGS=
